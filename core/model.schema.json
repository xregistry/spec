{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://xregistry.io/xregistryspecs/core-v1/schemas/model.schema.json",
  "title": "xRegistry Core Model Schema",
  "description": "JSON Schema defining the structure of an xRegistry model",
  "type": "object",
  "properties": {
    "$include": { "$ref": "#/definitions/IncludeReference" },
    "$includes": { "$ref": "#/definitions/IncludeReferences" },
    "description": {
      "type": "string",
      "description": "Human-readable description of the Registry model"
    },
    "documentation": {
      "type": "string",
      "format": "uri",
      "description": "URL of the documentation for the Registry model"
    },
    "labels": {
      "$ref": "#/definitions/Labels"
    },
    "attributes": {
      "$ref": "#/definitions/StrictAttributeDefinitions",
      "description": "Registry level extensions"
    },
    "groups": {
      "type": "object",
      "description": "Collection of group definitions",
      "properties": {
        "$include": { "$ref": "#/definitions/IncludeReference" },
        "$includes": { "$ref": "#/definitions/IncludeReferences" }
      },
      "patternProperties": {
        "^[a-z_][a-z0-9_]{0,56}$": {
          "$ref": "#/definitions/GroupDefinition"
        }
      },
      "additionalProperties": false,
      "allOf": [ { "$ref": "#/definitions/IncludeExclusivity" } ]
    }
  },
  "additionalProperties": true,
  "allOf": [ { "$ref": "#/definitions/IncludeExclusivity" } ],
  "definitions": {
    "IncludeReference": {
      "type": "string",
      "description": "Single include reference: <PATH-TO-DOCUMENT>#<JSON-POINTER>"
    },
    "IncludeReferences": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Ordered include references; earlier entries take precedence"
    },
    "IncludeExclusivity": {
      "not": { "required": ["$include", "$includes"] },
      "description": "$include and $includes MUST NOT appear at the same level"
    },
    "NoIncludeDirective": {
      "not": {
        "anyOf": [
          { "required": ["$include"] },
          { "required": ["$includes"] }
        ]
      }
    },
    "GroupDefinition": {
      "type": "object",
      "properties": {
            "$include": { "$ref": "#/definitions/IncludeReference" },
            "$includes": { "$ref": "#/definitions/IncludeReferences" },
            "singular": {
              "type": "string",
              "pattern": "^[a-z_][a-z0-9_]{0,62}$",
              "description": "Singular name of the group type (<=63 per core/model.md; the proposed 61 bound depends on xregistry/spec#677)"
            },
            "plural": {
              "type": "string",
              "pattern": "^[a-z_][a-z0-9_]{0,56}$",
              "description": "Plural name of the group type (<=57)"
            },
            "description": {
              "type": "string",
              "description": "Human-readable description of the group type"
            },
            "documentation": {
              "type": "string",
              "format": "uri",
              "description": "URL of the documentation for the group type"
            },
            "icon": {
              "type": "string",
              "format": "uri",
              "description": "URL of the icon for the group type"
            },
            "modelversion": {
              "type": "string",
              "description": "Version of the group model"
            },
            "modelcompatiblewith": {
              "type": "string",
              "format": "uri",
              "description": "Statement of compatibility with model spec"
            },
            "labels": {
              "$ref": "#/definitions/Labels"
            },
            "attributes": {
              "$ref": "#/definitions/StrictAttributeDefinitions",
              "description": "Custom attributes for this group type"
            },
            "ximportresources": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^/[a-z_][a-z0-9_]{0,56}/[a-z_][a-z0-9_]{0,56}$"
              },
              "description": "Include these Resources"
            },
            "constraints": {
              "$ref": "#/definitions/GroupConstraints"
            },
            "resources": {
              "type": "object",
              "description": "Resource types within this group",
              "properties": {
                "$include": { "$ref": "#/definitions/IncludeReference" },
                "$includes": { "$ref": "#/definitions/IncludeReferences" }
              },
              "patternProperties": {
                "^[a-z_][a-z0-9_]{0,56}$": {
                  "$ref": "#/definitions/ResourceDefinition"
                }
              },
              "additionalProperties": false,
              "allOf": [ { "$ref": "#/definitions/IncludeExclusivity" } ]
            }
      },
      "additionalProperties": false,
      "allOf": [
        { "$ref": "#/definitions/IncludeExclusivity" },
        {
          "if": { "$ref": "#/definitions/NoIncludeDirective" },
          "then": { "required": ["singular"] }
        }
      ]
    },
    "GroupConstraints": {
      "type": "object",
      "description": "Group level constraints over resources",
      "properties": {
        "$include": { "$ref": "#/definitions/IncludeReference" },
        "$includes": { "$ref": "#/definitions/IncludeReferences" }
      },
      "patternProperties": {
        "^[a-z_][a-z0-9_]{0,56}\\..+$": {
          "$ref": "#/definitions/GroupConstraint"
        }
      },
      "additionalProperties": false,
      "allOf": [ { "$ref": "#/definitions/IncludeExclusivity" } ]
    },
    "GroupConstraint": {
      "type": "object",
      "properties": {
        "$include": { "$ref": "#/definitions/IncludeReference" },
        "$includes": { "$ref": "#/definitions/IncludeReferences" },
        "default": {
          "type": [ "string", "number", "integer", "boolean" ]
        },
        "enum": {
          "type": "array",
          "items": {
            "type": [ "string", "number", "integer", "boolean" ]
          },
          "description": "An empty list adds no further restriction"
        },
        "equals": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "allOf": [ { "$ref": "#/definitions/IncludeExclusivity" } ]
    },
    "ResourceDefinition": {
      "type": "object",
      "properties": {
            "$include": { "$ref": "#/definitions/IncludeReference" },
            "$includes": { "$ref": "#/definitions/IncludeReferences" },
            "singular": {
              "type": "string",
              "pattern": "^[a-z_][a-z0-9_]{0,56}$",
              "description": "Singular name of the resource type (<=57)"
            },
            "plural": {
              "type": "string",
              "pattern": "^[a-z_][a-z0-9_]{0,56}$",
              "description": "Plural name of the resource type (<=57)"
            },
            "description": {
              "type": "string",
              "description": "Human-readable description of the resource type"
            },
            "documentation": {
              "type": "string",
              "format": "uri",
              "description": "URL of the documentation for the resource type"
            },
            "icon": {
              "type": "string",
              "format": "uri",
              "description": "URL of the icon for the resource type"
            },
            "maxversions": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "description": "Number of Versions that will be stored (0=unlimited)"
            },
            "setversionid": {
              "type": "boolean",
              "default": true,
              "description": "Whether client-side setting of versionid is supported"
            },
            "hasdocument": {
              "type": "boolean",
              "default": true,
              "description": "Whether resources of this type have associated documents"
            },
            "versionmode": {
              "type": "string",
              "pattern": "^([mM][aA][nN][uU][aA][lL]|[cC][rR][eE][aA][tT][eE][dD][aA][tT]|[mM][oO][dD][iI][fF][iI][eE][dD][aA][tT]|[sS][eE][mM][vV][eE][rR])$",
              "default": "manual",
              "description": "Algorithm for Version management; the value is case-insensitive"
            },
            "singleversionroot": {
              "type": "boolean",
              "default": false,
              "description": "Whether to enforce single root Version"
            },
            "validateformat": {
              "type": "boolean",
              "default": false,
              "description": "Whether to perform Version format checks"
            },
            "validatecompatibility": {
              "type": "boolean",
              "default": false,
              "description": "Whether to perform Version compatibility checks"
            },
            "strictvalidation": {
              "type": "boolean",
              "default": false,
              "description": "Whether to reject unknown format and compatibility validators"
            },
            "typemap": {
              "type": "object",
              "properties": {
                "$include": { "$ref": "#/definitions/IncludeReference" },
                "$includes": { "$ref": "#/definitions/IncludeReferences" }
              },
              "patternProperties": {
                "^(?!\\$includes?$).+$": {
                  "type": "string",
                  "pattern": "^([bB][iI][nN][aA][rR][yY]|[jJ][sS][oO][nN]|[sS][tT][rR][iI][nN][gG])$"
                }
              },
              "additionalProperties": false,
              "allOf": [ { "$ref": "#/definitions/IncludeExclusivity" } ],
              "description": "Content type mappings; keys and values are case-insensitive"
            },
            "modelversion": {
              "type": "string",
              "description": "Version of the resource model"
            },
            "modelcompatiblewith": {
              "type": "string",
              "format": "uri",
              "description": "Statement of compatibility with model spec"
            },
            "labels": {
              "$ref": "#/definitions/Labels"
            },
            "attributes": {
              "$ref": "#/definitions/StrictAttributeDefinitions",
              "description": "Version attributes/extensions"
            },
            "resourceattributes": {
              "$ref": "#/definitions/StrictAttributeDefinitions",
              "description": "Resource attributes/extensions"
            },
            "metaattributes": {
              "$ref": "#/definitions/StrictAttributeDefinitions",
              "description": "Meta attributes/extensions"
            }
      },
      "additionalProperties": false,
      "allOf": [
        { "$ref": "#/definitions/IncludeExclusivity" },
        {
          "if": { "$ref": "#/definitions/NoIncludeDirective" },
          "then": { "required": ["singular"] }
        }
      ]
    },
    "StrictAttributeDefinitions": {
      "type": "object",
      "description": "Attribute map whose names use the strict character set",
      "properties": {
        "$include": { "$ref": "#/definitions/IncludeReference" },
        "$includes": { "$ref": "#/definitions/IncludeReferences" },
        "*": {
          "$ref": "#/definitions/WildcardAttributeDefinition"
        }
      },
      "patternProperties": {
        "^[a-z_][a-z0-9_]{0,62}$": {
          "allOf": [
            { "$ref": "#/definitions/AttributeDefinition" },
            { "$ref": "#/definitions/StrictNameScope" }
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [ { "$ref": "#/definitions/IncludeExclusivity" } ]
    },
    "ExtendedAttributeDefinitions": {
      "type": "object",
      "description": "Attribute map of an object whose namecharset is extended",
      "properties": {
        "$include": { "$ref": "#/definitions/IncludeReference" },
        "$includes": { "$ref": "#/definitions/IncludeReferences" },
        "*": {
          "$ref": "#/definitions/WildcardAttributeDefinition"
        }
      },
      "patternProperties": {
        "^[a-z0-9][a-z0-9_:.\\-]{0,62}$": {
          "allOf": [
            { "$ref": "#/definitions/AttributeDefinition" },
            { "$ref": "#/definitions/ExtendedNameScope" }
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [ { "$ref": "#/definitions/IncludeExclusivity" } ]
    },
    "AnyAttributeDefinitions": {
      "type": "object",
      "description": "Attribute map before its owning object's character set is applied",
      "properties": {
        "$include": { "$ref": "#/definitions/IncludeReference" },
        "$includes": { "$ref": "#/definitions/IncludeReferences" },
        "*": {
          "$ref": "#/definitions/WildcardAttributeDefinition"
        }
      },
      "patternProperties": {
        "^[a-z_][a-z0-9_]{0,62}$": {
          "$ref": "#/definitions/AttributeDefinition"
        },
        "^[a-z0-9][a-z0-9_:.\\-]{0,62}$": {
          "$ref": "#/definitions/AttributeDefinition"
        }
      },
      "additionalProperties": false,
      "allOf": [ { "$ref": "#/definitions/IncludeExclusivity" } ]
    },
    "StrictNameScope": {
      "description": "Strict names for this definition and its conditional siblings",
      "properties": {
        "name": {
          "pattern": "^[a-z_][a-z0-9_]{0,62}$"
        },
        "ifvalues": {
          "additionalProperties": {
            "properties": {
              "siblingattributes": {
                "$ref": "#/definitions/StrictAttributeDefinitions"
              }
            }
          }
        }
      }
    },
    "ExtendedNameScope": {
      "description": "Extended names for this definition and its conditional siblings",
      "properties": {
        "name": {
          "pattern": "^[a-z0-9][a-z0-9_:.\\-]{0,62}$"
        },
        "ifvalues": {
          "additionalProperties": {
            "properties": {
              "siblingattributes": {
                "$ref": "#/definitions/ExtendedAttributeDefinitions"
              }
            }
          }
        }
      }
    },
    "WildcardAttributeDefinition": {
      "type": "object",
      "properties": {
        "$include": { "$ref": "#/definitions/IncludeReference" },
        "$includes": { "$ref": "#/definitions/IncludeReferences" },
        "name": {
          "const": "*",
          "description": "Name of wildcard attribute (must be '*')"
        },
        "type": {
          "type": "string",
          "enum": [
            "boolean", "string", "integer", "uinteger", "decimal",
            "uri", "uriabsolute", "urirelative", "uritemplate",
            "url", "urlabsolute", "urlrelative",
            "timestamp", "xid", "xidtype",
            "array", "map", "object", "any"
          ]
        },
        "description": {
          "type": "string"
        },
        "readonly": {
          "enum": [false, null],
          "description": "Wildcard: not modifiable"
        },
        "required": {
          "enum": [false, null],
          "description": "Wildcard: not required"
        },
        "ifvalues": {
          "not": {},
          "description": "Wildcard: no conditional attributes"
        }
      },
      "additionalProperties": true,
      "allOf": [
        { "$ref": "#/definitions/IncludeExclusivity" },
        {
          "if": { "$ref": "#/definitions/NoIncludeDirective" },
          "then": { "required": ["type"] }
        }
      ]
    },
    "AttributeDefinition": {
      "$ref": "#/definitions/FullAttributeDefinition"
    },
    "FullAttributeDefinition": {
      "type": "object",
      "description": "Source attribute definition; a completed definition also requires 'type' (see ExpandedModel)",
      "properties": {
        "$include": { "$ref": "#/definitions/IncludeReference" },
        "$includes": { "$ref": "#/definitions/IncludeReferences" },
        "name": {
          "type": "string",
          "pattern": "^([a-z_][a-z0-9_]{0,62}|[a-z0-9][a-z0-9_:.\\-]{0,62})$",
          "description": "Name of the attribute (must match the key). The applicable character set is strict ([a-z_][a-z0-9_]*) unless the owning object declares namecharset extended ([a-z0-9][a-z0-9_:.-]*); both are limited to 63 characters."
        },
        "type": {
          "type": "string",
          "enum": [
            "boolean", "string", "integer", "uinteger", "decimal",
            "uri", "uriabsolute", "urirelative", "uritemplate",
            "url", "urlabsolute", "urlrelative",
            "timestamp", "xid", "xidtype",
            "array", "map", "object", "any"
          ],
          "description": "Data type of the attribute"
        },
        "target": {
          "type": "string",
          "pattern": "^/[a-z_][a-z0-9_]{0,56}(/[a-z_][a-z0-9_]{0,56}(\\[/versions\\]|/versions)?)?$",
          "description": "Target entity type for xid/url/uri types. Uses the Group/Resource plural type-name grammar; existence and depth of the referenced type is semantic validation."
        },
        "namecharset": {
          "type": "string",
          "pattern": "^([sS][tT][rR][iI][cC][tT]|[eE][xX][tT][eE][nN][dD][eE][dD])$",
          "default": "strict",
          "description": "Character set for object attribute names; the value is case-insensitive. 'strict' allows [a-z_][a-z0-9_]*; 'extended' allows the map key character set [a-z0-9][a-z0-9_:.-]*."
        },
        "description": {
          "type": "string",
          "description": "Human-readable description of the attribute"
        },
        "enum": {
          "type": "array",
          "description": "Allowed values for scalar attributes"
        },
        "strict": {
          "type": "boolean",
          "default": true,
          "description": "Whether to restrict values to enum only"
        },
        "matchversions": {
          "type": "boolean",
          "default": false,
          "description": "Whether attribute must be the same across all versions"
        },
        "readonly": {
          "type": "boolean",
          "default": false,
          "description": "Whether this attribute is modifiable by clients"
        },
        "immutable": {
          "type": "boolean",
          "default": false,
          "description": "Whether this attribute can change once set"
        },
        "required": {
          "type": "boolean",
          "default": false,
          "description": "Whether this attribute must have a non-null value"
        },
        "default": {
          "description": "Default value for scalar attributes"
        },
        "attributes": {
          "description": "Nested attributes for object types; the applicable character set is selected by this definition's namecharset"
        },
        "item": {
          "$ref": "#/definitions/ItemDefinition",
          "description": "Item definition for array/map types"
        },
        "ifvalues": {
          "type": "object",
          "properties": {
            "$include": { "$ref": "#/definitions/IncludeReference" },
            "$includes": { "$ref": "#/definitions/IncludeReferences" }
          },
          "patternProperties": {
            "^(?!\\$includes?$)[^\\^].*$": {
              "$ref": "#/definitions/IfValueBranch"
            }
          },
          "additionalProperties": false,
          "allOf": [ { "$ref": "#/definitions/IncludeExclusivity" } ],
          "description": "Conditional attributes based on values"
        }
      },
      "additionalProperties": false,
      "allOf": [
        { "$ref": "#/definitions/IncludeExclusivity" },
        {
          "if": {
            "properties": {
              "type": { "enum": ["array", "map"] }
            },
            "required": ["type"]
          },
          "then": {
            "required": ["item"]
          }
        },
        {
          "if": {
            "properties": {
              "default": { "not": { "type": "null" } }
            },
            "required": ["default"]
          },
          "then": {
            "properties": {
              "required": { "const": true }
            }
          }
        },
        {
          "if": {
            "properties": {
              "namecharset": {
                "pattern": "^[eE][xX][tT][eE][nN][dD][eE][dD]$"
              }
            },
            "required": ["namecharset"]
          },
          "then": {
            "properties": {
              "attributes": { "$ref": "#/definitions/ExtendedAttributeDefinitions" }
            }
          },
          "else": {
            "properties": {
              "attributes": { "$ref": "#/definitions/StrictAttributeDefinitions" }
            }
          }
        }
      ]
    },
    "IfValueBranch": {
      "type": "object",
      "properties": {
        "$include": { "$ref": "#/definitions/IncludeReference" },
        "$includes": { "$ref": "#/definitions/IncludeReferences" },
        "siblingattributes": {
          "$ref": "#/definitions/AnyAttributeDefinitions"
        }
      },
      "additionalProperties": false,
      "allOf": [
        { "$ref": "#/definitions/IncludeExclusivity" },
        {
          "if": { "$ref": "#/definitions/NoIncludeDirective" },
          "then": { "required": ["siblingattributes"] }
        }
      ]
    },
    "ItemDefinition": {
      "type": "object",
      "properties": {
        "$include": { "$ref": "#/definitions/IncludeReference" },
        "$includes": { "$ref": "#/definitions/IncludeReferences" },
        "type": {
          "type": "string",
          "enum": [
            "boolean", "string", "integer", "uinteger", "decimal",
            "uri", "uriabsolute", "urirelative", "uritemplate",
            "url", "urlabsolute", "urlrelative",
            "timestamp", "xid", "xidtype",
            "array", "map", "object", "any"
          ]
        },
        "target": {
          "type": "string",
          "pattern": "^/[a-z_][a-z0-9_]{0,56}(/[a-z_][a-z0-9_]{0,56}(\\[/versions\\]|/versions)?)?$"
        },
        "namecharset": {
          "type": "string",
          "pattern": "^([sS][tT][rR][iI][cC][tT]|[eE][xX][tT][eE][nN][dD][eE][dD])$",
          "default": "strict"
        },
        "enum": {
          "type": "array",
          "description": "Allowed values for scalar items; membership, 'strict' and the empty or absent set follow the attribute 'enum' rules"
        },
        "strict": {
          "type": "boolean",
          "default": true,
          "description": "Whether to restrict item values to enum only"
        },
        "attributes": {
          "description": "Nested attributes for object items; the applicable character set is selected by this item's namecharset"
        },
        "item": {
          "$ref": "#/definitions/ItemDefinition"
        }
      },
      "additionalProperties": false,
      "allOf": [
        { "$ref": "#/definitions/IncludeExclusivity" },
        {
          "if": { "$ref": "#/definitions/NoIncludeDirective" },
          "then": { "required": ["type"] }
        },
        {
          "if": {
            "properties": {
              "type": { "enum": ["array", "map"] }
            },
            "required": ["type"]
          },
          "then": {
            "required": ["item"]
          }
        },
        {
          "if": {
            "properties": {
              "type": { "enum": ["array", "map", "object", "any"] }
            },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "enum": {
                "not": {},
                "description": "Only scalar items carry a value set; a container recurses through its own 'item'"
              },
              "strict": {
                "not": {},
                "description": "Only scalar items carry a value set, so only they qualify one"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "namecharset": {
                "pattern": "^[eE][xX][tT][eE][nN][dD][eE][dD]$"
              }
            },
            "required": ["namecharset"]
          },
          "then": {
            "properties": {
              "attributes": { "$ref": "#/definitions/ExtendedAttributeDefinitions" }
            }
          },
          "else": {
            "properties": {
              "attributes": { "$ref": "#/definitions/StrictAttributeDefinitions" }
            }
          }
        }
      ]
    },
    "Labels": {
      "type": "object",
      "properties": {
        "$include": { "$ref": "#/definitions/IncludeReference" },
        "$includes": { "$ref": "#/definitions/IncludeReferences" }
      },
      "patternProperties": {
        "^(?!\\$includes?$).+$": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "allOf": [ { "$ref": "#/definitions/IncludeExclusivity" } ],
      "description": "Key-value pairs for labeling"
    },
    "ExpandedModel": {
      "description": "Expanded structural stage: the model after the include directives have been resolved by a real resolver. It does not overlay the specification-defined attributes and performs no semantic conformance checking.",
      "allOf": [
        { "$ref": "#" },
        { "$ref": "#/definitions/NoIncludeDirective" },
        {
          "properties": {
            "attributes": { "$ref": "#/definitions/ExpandedAttributeDefinitions" },
            "groups": {
              "additionalProperties": {
                "$ref": "#/definitions/ExpandedGroupDefinition"
              }
            }
          }
        }
      ]
    },
    "ExpandedGroupDefinition": {
      "type": "object",
      "required": ["singular"],
      "allOf": [ { "$ref": "#/definitions/NoIncludeDirective" } ],
      "properties": {
        "attributes": { "$ref": "#/definitions/ExpandedAttributeDefinitions" },
        "resources": {
          "additionalProperties": {
            "$ref": "#/definitions/ExpandedResourceDefinition"
          }
        }
      }
    },
    "ExpandedResourceDefinition": {
      "type": "object",
      "required": ["singular"],
      "allOf": [ { "$ref": "#/definitions/NoIncludeDirective" } ],
      "properties": {
        "attributes": { "$ref": "#/definitions/ExpandedAttributeDefinitions" },
        "resourceattributes": { "$ref": "#/definitions/ExpandedAttributeDefinitions" },
        "metaattributes": { "$ref": "#/definitions/ExpandedAttributeDefinitions" }
      }
    },
