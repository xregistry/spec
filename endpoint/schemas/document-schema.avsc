                                        }
                                      }
                                    ]
                                  }
                                }
                              ],
                              "name": "authorization",
                              "doc": "Authorization options. These are hints for the adapter for interacting with the authorization endpoint. This is not a credentials configuration",
                              "default": null
                            },
                            {
                              "type": [
                                "null",
                                "boolean"
                              ],
                              "doc": "If `true`, the endpoint metadata represents a public endpoint that is expected to be available for communication",
                              "name": "deployed",
                              "default": null
                            },
                            {
                              "type": [
                                "null",
                                "string"
                              ],
                              "doc": "The AMQP node name. Commonly the name of a queue or a topic. Corresponds to the 'address' in source or target of the attach frame.",
                              "name": "node",
                              "default": null
                            },
                            {
                              "type": [
                                "null",
                                "boolean"
                              ],
                              "doc": "Whether the AMQP node identified by 'node' is durable rather than transient. This is a property of the node, not of the link terminus and not of the message header field of the same name. Terminus durability is expressed by 'terminus-durability'",
                              "name": "durable",
                              "default": null
                            },
                            {
                              "type": [
                                "null",
                                {
                                  "type": "map",
                                  "name": "EndpointProtocolAmqp10ProtocoloptionsLinkPropertiesType",
                                  "values": "string"
                                }
                              ],
                              "name": "linkProperties",
                              "doc": "An optional map of AMQP link properties to use with the endpoint",
                              "default": null
                            },
                            {
                              "type": [
                                "null",
                                {
                                  "type": "map",
                                  "name": "EndpointProtocolAmqp10ProtocoloptionsConnectionPropertiesType",
                                  "values": "string"
                                }
                              ],
                              "name": "connectionProperties",
                              "doc": "An optional map of AMQP connection properties to use with the endpoint",
                              "default": null
                            },
                            {
                              "type": [
                                "null",
                                "string"
                              ],
                              "doc": "The AMQP source distribution mode. 'move' means a transferred message is removed from the node and is therefore seen by only one receiver. 'copy' means the message remains at the node after transfer and may also be transferred to other receivers. This does not describe message locking",
                              "name": "distributionMode",
                              "default": null
                            },
                            {
                              "type": [
                                "null",
                                {
                                  "type": "array",
                                  "name": "EndpointProtocolAmqp10ProtocoloptionsConnectionCapabilitiesArrayType",
                                  "items": {
                                    "type": "string"
                                  }
                                }
                              ],
                              "name": "connectionCapabilities",
                              "doc": "The AMQP capabilities to use with the endpoint",
                              "default": null
                            },
                            {
                              "type": [
                                "null",
                                {
                                  "type": "array",
                                  "name": "EndpointProtocolAmqp10ProtocoloptionsNodeCapabilitiesArrayType",
                                  "items": {
                                    "type": "string"
                                  }
                                }
                              ],
