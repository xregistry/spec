                "coreType": "uinteger",
                "encoding": "json-number-token",
                "constraints": {}
              },
              "x-xregistryOptional": true,
              "doc": "Optimistic concurrency update counter",
              "default": {}
            },
            {
              "name": "self",
              "type": "string",
              "doc": "URL of the object"
            },
            {
              "name": "xid",
              "type": "string",
