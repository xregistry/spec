{
  "type": "record",
  "name": "DocumentType",
  "namespace": "io.xregistry",
  "fields": [
    {
      "name": "genericRecordDefinition",
      "type": {
        "type": "array",
        "items": {
          "type": "record",
          "name": "GenericRecord",
          "fields": [
            {
              "name": "object",
              "type": {
                "type": "map",
                "values": [
                  "null",
                  "boolean",
                  "int",
                  "long",
                  "float",
                  "double",
                  "bytes",
                  "string",
                  {
                    "type": "array",
                    "items": [
                      "null",
                      "boolean",
                      "int",
                      "long",
                      "float",
                      "double",
                      "bytes",
                      "string",
                      "io.xregistry.GenericRecord"
                    ]
                  },
                  "io.xregistry.GenericRecord"
                ]
              }
            }
          ],
          "x-xregistryJsonCarrier": "core-json/1"
        }
      },
      "default": [],
      "doc": "Internal field to define GenericRecord type for use in extension attributes",
      "x-xregistryInternal": true
    },
    {
      "name": "messagegroups",
      "type": {
        "type": "map",
        "values": {
          "type": "record",
          "name": "MessagegroupType",
          "fields": [
            {
              "name": "messagegroupid",
              "type": "string",
              "description": "ID of the messagegroup object"
            },
            {
              "name": "name",
              "type": [
                "string",
                "null"
              ],
              "doc": "Name of the object"
            },
            {
              "name": "epoch",
              "type": [
                {
                  "type": "record",
                  "name": "io.xregistry.MessagegroupType_epoch_AbsentV1",
