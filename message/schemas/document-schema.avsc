                      "x-xregistryOptional": true,
                      "doc": "Time of the object creation",
                      "default": {}
                    },
                    {
                      "name": "modifiedat",
                      "type": [
                        {
                          "type": "record",
                          "name": "io.xregistry.messagegroups.MessageType_modifiedat_AbsentV1",
                          "fields": [],
