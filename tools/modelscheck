#!/bin/bash

set -e

function clean() {
    set +e
    if [[ -n "$tmpModel" ]]; then
        rm -f -- "$tmpModel"
    fi
    echo "# Stopping server"
    docker rm -f xrserver > /dev/null
}

tmpModel=""

badPatterns=(
  "required.*false"
  "hasdoc.*true"
  "plural"
)

trap clean EXIT

export XR_IMAGE=ghcr.io/xregistry/xr
export XRSERVER_IMAGE=ghcr.io/xregistry/xrserver-all
export XR_SERVER=http://localhost:8383

export XR="xr"

if ! which xr > /dev/null 2>&1 ; then
  export XR="docker run -i --network=host -v .:/spec -w /spec \
    $XR_IMAGE -s localhost:8383"
fi

# The external xr validator predates Core's binary type. Validate the original
# models against Core's schema, then use a temporary string-typed copy only for
# the external validator and server.
echo "# Validating models against the Core model schema"
python tools/validate-models.py

# Start an xrserver to test loading the models and sample data
echo -n "# Starting xrserver"
docker run -qdti --name xrserver -p 8383:8080 $XRSERVER_IMAGE \
    --rootapp=xreg > /dev/null

while ! curl --silent --fail $XR_SERVER > /dev/null;do echo -n . && sleep 2;done
echo ; echo

# Validate all model.json files in the entire repo
for fn in `find . -name \*model.json`; do
    echo "# Model: $fn"
    modelForXR="$fn"
    if grep -q '"type"[[:space:]]*:[[:space:]]*"binary"' "$fn"; then
        tmpModel=$(mktemp "$(dirname "$fn")/model-compat-XXXXXX.json")
        python - "$fn" "$tmpModel" <<'PY'
import json
import sys

def map_types(value):
    if isinstance(value, dict):
        return {
            key: "string" if key == "type" and item == "binary" else map_types(item)
            for key, item in value.items()
        }
    if isinstance(value, list):
        return [map_types(item) for item in value]
    return value

with open(sys.argv[1], encoding="utf-8") as source:
    model = json.load(source)
with open(sys.argv[2], "w", encoding="utf-8") as target:
    json.dump(map_types(model), target, indent=2)
    target.write("\n")
PY
        modelForXR="$tmpModel"
    fi
    echo "  # Verifying"
    $XR model verify "$modelForXR"

    # Look for anti-patterns in the model
    for pattern in "${badPatterns[@]}" ; do
        if ( grep "$pattern" "$fn" > /dev/null ); then
            echo Found "'$pattern'"
            exit 1
        fi
    done

    echo "  # Loading"
    $XR model update "$modelForXR"

    dir=$(dirname $fn)
    echo "  # Looking for samples (*.xreg.json) in: $dir"
    for data in `find $dir -name \*xreg.json`; do
        echo "  # Sample: $data"
        $XR update / -d @$data
    done

    list=$($XR model group list | grep -v GROUP | sed "s/\/.*//g")
    list=$(echo $list)
    if [[ "$list" != "" ]]; then
        echo "  # Deleting group instances: $list"
        $XR delete $list
        echo "  # Deleting group models: $list"
        $XR model group delete $list
    fi

    if [[ -n "$tmpModel" ]]; then
        rm -f -- "$tmpModel"
        tmpModel=""
    fi

echo
done
