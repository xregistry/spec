{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:xregistry:document-tree:index:1",
  "title": "xRegistry document-tree collection index, working draft 1",
  "type": "object",
  "required": ["format", "formatversion", "kind", "xid", "count", "entries"],
  "additionalProperties": false,
  "properties": {
    "format": {"const": "xregistry-document-tree"},
    "formatversion": {"const": "1"},
    "kind": {"const": "collection"},
    "xid": {
      "allOf": [
        {"$ref": "urn:xregistry:document-tree:record:1#/$defs/xid"},
        {"pattern": "^/[^/]+(?:/[^/]+/[^/]+(?:/[^/]+/versions)?)?$"}
      ]
    },
    "count": {"type": "integer", "minimum": 0},
    "entries": {
      "type": "array",
      "items": {
        "allOf": [
          {"$ref": "urn:xregistry:document-tree:record:1#/$defs/reference"},
          {"properties": {"kind": {"enum": ["group", "resource", "version"]}}}
        ]
      }
    }
  }
}
