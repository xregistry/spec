{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "http://opcfoundation.org/UA/WoT-Binding/publication-closure/1",
  "title": "Proposed WoT publication dependency closure",
  "type": "object",
  "required": ["format", "entries", "bindings"],
  "properties": {
    "format": {"const": "wot-publication-closure/1"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/versionXid"}
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "pointer", "operator", "href", "target"],
        "properties": {
          "source": {"$ref": "#/$defs/versionXid"},
          "pointer": {
            "type": "string",
            "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
          },
          "operator": {"type": "string", "minLength": 1},
          "href": {"type": "string", "minLength": 1},
          "target": {"$ref": "#/$defs/versionXid"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "versionXid": {
      "type": "string",
      "pattern": "^/[^/?#]+/[^/?#]+/[^/?#]+/[^/?#]+/versions/[^/?#]+$"
    }
  }
}
