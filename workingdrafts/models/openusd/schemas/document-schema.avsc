                              },
                              {
                                "type": "string",
                                "doc": "The document format of this artifact. Orthogonal to assetkind, which records the artifact's role in the closure",
                                "name": "format"
                              },
                              {
                                "type": "string",
                                "doc": "The authored USD asset identifier, normalized relative to its asset container - the string a layer writes between @...@. It is the Resource source identity and the authority: the usdassetid is the symbolic identifier constructed from it, a one-way construction that is never inverted",
                                "name": "assetidentifier"
                              },
                              {
                                "type": "string",
                                "doc": "The role this artifact plays in its container's composition closure. Exactly one usdasset in an asset container has the value RootLayer",
                                "name": "assetkind"
                              },
                              {
                                "type": {
                                  "type": "array",
                                  "name": "DependsonArrayType",
                                  "items": {
                                    "type": "string"
                                  }
                                },
                                "name": "dependson",
                                "doc": "The asset identifiers this artifact directly references, in authored order - authored identifiers, not xids, so a resolver matches them against @...@ references directly"
                              },
                              {
                                "type": "string",
                                "doc": "Lower-case hexadecimal digest of the exact document bytes a Consumer retrieves, computed with digestalg",
                                "name": "digest"
                              },
                              {
                                "type": "string",
                                "doc": "The algorithm used to compute digest. REQUIRED when digest is present",
                                "name": "digestalg"
                              },
