          },
          "labels": {
            "type": "object",
            "description": "Labels for the object"
          },
          "createdat": {
            "type": "string",
            "format": "date-time",
            "description": "Time of the object creation"
          },
          "modifiedat": {
            "type": "string",
            "format": "date-time",
            "description": "Time of the object modification"
          }
        },
        "oneOf": [
          {
            "properties": {
              "versionsurl": {
                "type": "string"
              },
              "versionscount": {
                "type": "integer"
              }
            },
