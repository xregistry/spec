{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://xregistry.io/workingdrafts/models/registry/schemas/document-schema.json",
  "properties": {
    "categories": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/category-schema/category"
      }
    }
  },
  "definitions": {
    "category-schema": {
      "registryVersion": {
        "type": "object",
        "properties": {
          "versionid": {
            "type": "string",
            "description": "ID of the registry version"
          },
          "registryid": {
            "type": "string",
            "description": "ID of the registry object"
          },
          "name": {
            "type": "string",
            "description": "Name of the object"
          },
          "epoch": {
            "type": "integer",
            "description": "Epoch time of the object creation"
          },
          "self": {
            "type": "string",
            "format": "uri",
            "description": "URL of the object"
          },
          "xid": {
            "type": "string",
            "format": "xid",
            "description": "Relative URL of the object"
          },
          "description": {
            "type": "string",
            "description": "Description of the object"
          },
          "documentation": {
            "type": "string",
            "format": "uri",
            "description": "URI of the documentation of the object"
          },
          "labels": {
            "type": "object",
            "description": "Labels for the object"
          },
          "createdat": {
            "type": "string",
            "format": "date-time",
            "description": "Time of the object creation"
          },
          "modifiedat": {
            "type": "string",
            "format": "date-time",
            "description": "Time of the object modification"
          },
          "xregurl": {
            "type": "string",
            "format": "uri",
            "description": "xRegistry HTTP Registry root URL."
          },
          "weburl": {
            "type": "string",
            "format": "uri",
            "description": "Human-facing website. Not a resolution advertisement."
          },
          "registrytypes": {
            "type": "array",
            "description": "Descriptive domain or model URI identifiers.",
            "items": {
              "type": "string"
            }
          },
          "authority": {
            "type": "string",
            "format": "uri",
            "description": "Administrative authority identifier. Not a trust claim."
          },
          "federationprofiles": {
            "type": "array",
            "description": "Ordered access advertisements for one logical Registry.",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "Nonempty, case-sensitive binding identifier."
                },
                "endpoint": {
                  "type": "string",
                  "format": "uri",
                  "description": "Absolute, credential-free binding endpoint URI."
                },
                "priority": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Lower values are preferred. Absence means 0."
                },
                "parameters": {
                  "type": "object",
                  "description": "Binding parameters. Absence means an empty object.",
                  "properties": {}
                }
              },
              "required": [
                "name",
                "endpoint"
              ]
            }
          },
          "relationships": {
            "type": "array",
            "description": "Descriptive links to catalog entries, not instructions.",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "description": "Nonempty relationship identifier."
                },
                "target": {
                  "type": "string",
                  "format": "uri",
                  "description": "Catalog-root Resource XID or absolute entry URI."
                },
                "labels": {
                  "type": "object",
                  "description": "Ordinary Core labels describing this relationship.",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "type",
                "target"
              ]
            }
          }
        }
      },
      "registry": {
        "type": "object",
        "properties": {
          "registryid": {
            "type": "string",
            "description": "ID of the registry object"
          },
          "name": {
            "type": "string",
            "description": "Name of the object"
          },
          "epoch": {
            "type": "integer",
            "description": "Epoch time of the object creation"
          },
          "self": {
            "type": "string",
            "format": "uri",
            "description": "URL of the object"
          },
          "xid": {
            "type": "string",
            "format": "xid",
            "description": "Relative URL of the object"
          },
          "description": {
            "type": "string",
            "description": "Description of the object"
          },
          "documentation": {
            "type": "string",
            "format": "uri",
            "description": "URI of the documentation of the object"
          },
          "labels": {
            "type": "object",
            "description": "Labels for the object"
          },
          "createdat": {
            "type": "string",
            "format": "date-time",
            "description": "Time of the object creation"
          },
          "modifiedat": {
            "type": "string",
            "format": "date-time",
            "description": "Time of the object modification"
          }
        },
        "oneOf": [
          {
            "properties": {
              "versionsurl": {
                "type": "string"
              },
              "versionscount": {
                "type": "integer"
              }
            },
            "required": [
              "versionsurl"
            ]
          },
          {
            "properties": {
              "versions": {
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/definitions/category-schema/registryVersion"
                }
              }
            },
            "required": [
              "versions"
            ]
          }
        ]
      },
      "category": {
        "type": "object",
        "properties": {
          "categoryid": {
            "type": "string",
            "description": "ID of the category object"
          },
          "name": {
            "type": "string",
            "description": "Name of the object"
          },
          "epoch": {
            "type": "integer",
            "description": "Epoch time of the object creation"
          },
          "self": {
            "type": "string",
            "format": "uri",
            "description": "URL of the object"
          },
          "xid": {
            "type": "string",
            "format": "xid",
            "description": "Relative URL of the object"
          },
          "description": {
            "type": "string",
            "description": "Description of the object"
          },
          "documentation": {
            "type": "string",
            "format": "uri",
            "description": "URI of the documentation of the object"
          },
          "labels": {
            "type": "object",
            "description": "Labels for the object"
          },
          "createdat": {
            "type": "string",
            "format": "date-time",
            "description": "Time of the object creation"
          },
          "modifiedat": {
            "type": "string",
            "format": "date-time",
            "description": "Time of the object modification"
          },
          "registries": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/definitions/category-schema/registry"
            }
          }
        }
      }
    }
  }
}