{
  "$schema": "https://json-structure.org/meta/extended/v0/#",
  "$id": "https://xregistry.io/workingdrafts/models/registry/schemas/document-schema.struct.json",
  "$uses": [
    "JSONStructureAlternateNames"
  ],
  "name": "RegistryOfRegistriesDocument",
  "type": "object",
  "properties": {
    "categories": {
      "type": "map",
      "values": {
        "type": {
          "$ref": "#/definitions/Categories/Category"
        }
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "Categories": {
      "RegistryVersionFederationprofilesItem": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Nonempty, case-sensitive binding identifier."
          },
          "endpoint": {
            "type": "uri",
            "description": "Absolute, credential-free binding endpoint URI."
          },
          "priority": {
            "type": "uint32",
            "description": "Lower values are preferred. Absence means 0."
          },
          "parameters": {
            "type": "object",
            "properties": {},
            "additionalProperties": true,
            "description": "Binding parameters. Absence means an empty object."
          }
        },
        "additionalProperties": false,
        "required": [
          "name",
          "endpoint"
        ]
      },
      "RegistryVersionRelationshipsItem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "Nonempty relationship identifier."
          },
          "target": {
            "type": "uri",
            "description": "Catalog-root Resource XID or absolute entry URI."
          },
          "labels": {
            "type": "map",
            "values": {
              "type": "string"
            },
            "description": "Ordinary Core labels describing this relationship."
          }
        },
        "additionalProperties": false,
        "required": [
          "type",
          "target"
        ]
      },
      "RegistryVersion": {
        "type": "object",
        "properties": {
          "versionid": {
            "type": "string",
            "description": "ID of the registry version"
          },
          "registryid": {
            "type": "string",
            "description": "ID of the registry object"
          },
          "name": {
            "type": "string",
            "description": "Name of the object"
          },
          "epoch": {
            "type": "integer",
            "description": "Epoch of the object"
          },
          "self": {
            "type": "uri",
            "description": "URL of the object"
          },
          "xid": {
            "type": "uri",
            "description": "XID of the object"
          },
          "description": {
            "type": "string",
            "description": "Description of the object"
          },
          "documentation": {
            "type": "uri",
            "description": "Documentation URL"
          },
          "labels": {
            "type": "map",
            "values": {
              "type": "string"
            }
          },
          "createdat": {
            "type": "datetime",
            "description": "Creation time"
          },
          "modifiedat": {
            "type": "datetime",
            "description": "Modification time"
          },
          "xregurl": {
            "type": "uri",
            "description": "xRegistry HTTP Registry root URL."
          },
          "weburl": {
            "type": "uri",
            "description": "Human-facing website. Not a resolution advertisement."
          },
          "registrytypes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Descriptive domain or model URI identifiers."
          },
          "authority": {
            "type": "uri",
            "description": "Administrative authority identifier. Not a trust claim."
          },
          "federationprofiles": {
            "type": "array",
            "items": {
              "type": {
                "$ref": "#/definitions/Categories/RegistryVersionFederationprofilesItem"
              }
            },
            "description": "Ordered access advertisements for one logical Registry."
          },
          "relationships": {
            "type": "array",
            "items": {
              "type": {
                "$ref": "#/definitions/Categories/RegistryVersionRelationshipsItem"
              }
            },
            "description": "Descriptive links to catalog entries, not instructions."
          }
        },
        "additionalProperties": true
      },
      "Registry": {
        "type": "object",
        "properties": {
          "registryid": {
            "type": "string",
            "description": "ID of the registry object"
          },
          "name": {
            "type": "string",
            "description": "Name of the object"
          },
          "epoch": {
            "type": "integer",
            "description": "Epoch of the object"
          },
          "self": {
            "type": "uri",
            "description": "URL of the object"
          },
          "xid": {
            "type": "uri",
            "description": "XID of the object"
          },
          "description": {
            "type": "string",
            "description": "Description of the object"
          },
          "documentation": {
            "type": "uri",
            "description": "Documentation URL"
          },
          "labels": {
            "type": "map",
            "values": {
              "type": "string"
            }
          },
          "createdat": {
            "type": "datetime",
            "description": "Creation time"
          },
          "modifiedat": {
            "type": "datetime",
            "description": "Modification time"
          },
          "versionsurl": {
            "type": "uri"
          },
          "versionscount": {
            "type": "uint32"
          },
          "versions": {
            "type": "map",
            "values": {
              "type": {
                "$ref": "#/definitions/Categories/RegistryVersion"
              }
            }
          }
        },
        "additionalProperties": false
      },
      "Category": {
        "type": "object",
        "properties": {
          "categoryid": {
            "type": "string",
            "description": "ID of the category object"
          },
          "name": {
            "type": "string",
            "description": "Name of the object"
          },
          "epoch": {
            "type": "integer",
            "description": "Epoch of the object"
          },
          "self": {
            "type": "uri",
            "description": "URL of the object"
          },
          "xid": {
            "type": "uri",
            "description": "XID of the object"
          },
          "description": {
            "type": "string",
            "description": "Description of the object"
          },
          "documentation": {
            "type": "uri",
            "description": "Documentation URL"
          },
          "labels": {
            "type": "map",
            "values": {
              "type": "string"
            }
          },
          "createdat": {
            "type": "datetime",
            "description": "Creation time"
          },
          "modifiedat": {
            "type": "datetime",
            "description": "Modification time"
          },
          "registries": {
            "type": "map",
            "values": {
              "type": {
                "$ref": "#/definitions/Categories/Registry"
              }
            }
          }
        },
        "additionalProperties": true
      }
    }
  }
}