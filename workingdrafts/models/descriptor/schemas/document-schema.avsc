{
  "type": "record",
  "name": "DocumentType",
  "namespace": "io.xregistry",
  "fields": [
    {
      "name": "genericRecordDefinition",
      "type": {
        "type": "array",
        "items": {
          "type": "record",
          "name": "GenericRecord",
          "fields": [
            {
              "name": "object",
              "type": {
                "type": "map",
                "values": [
                  "null",
                  "boolean",
                  "int",
                  "long",
                  "float",
                  "double",
                  "bytes",
                  "string",
                  {
                    "type": "array",
                    "items": [
                      "null",
                      "boolean",
                      "int",
                      "long",
                      "float",
                      "double",
                      "bytes",
                      "string",
                      "io.xregistry.GenericRecord"
                    ]
                  },
                  "io.xregistry.GenericRecord"
                ]
              }
            }
          ]
        }
      },
      "default": [],
      "doc": "Internal field to define GenericRecord type for use in extension attributes"
    },
    {
      "name": "descriptorgroups",
      "type": {
        "type": "map",
        "values": {
          "type": "record",
          "name": "DescriptorgroupType",
          "fields": [
            {
              "name": "descriptorgroupid",
              "type": "string",
              "description": "ID of the descriptorgroup object"
            },
            {
              "name": "name",
              "type": [
                "string",
                "null"
              ],
              "doc": "Name of the object"
            },
            {
              "name": "epoch",
              "type": [
                "int",
                "null"
              ],
              "doc": "Epoch time of the object creation"
            },
            {
              "name": "self",
              "type": "string",
              "doc": "URL of the object"
            },
            {
              "name": "xid",
              "type": "string",
              "doc": "XID of the object"
            },
            {
              "name": "description",
              "type": [
                "string",
                "null"
              ],
              "doc": "Description of the object"
            },
            {
              "name": "documentation",
              "type": [
                "string",
                "null"
              ],
              "doc": "URI of the documentation of the object"
            },
            {
              "name": "labels",
              "type": {
                "type": "map",
                "values": [
                  "string",
                  "null"
                ]
              },
              "doc": "Labels for the object"
            },
            {
              "name": "createdat",
              "type": [
                {
                  "type": "int",
                  "logicalType": "time-millis"
                },
                "null"
              ],
              "doc": "Time of the object creation"
            },
            {
              "name": "modifiedat",
              "type": [
                {
                  "type": "int",
                  "logicalType": "time-millis"
                },
                "null"
              ],
              "doc": "Time of the object modification"
            },
            {
              "name": "Extensions",
              "type": [
                "null",
                {
                  "type": "map",
                  "name": "ExtensionsType",
                  "default": {},
                  "values": "io.xregistry.GenericRecord"
                }
              ],
              "default": null
            },
            {
              "name": "descriptors",
              "type": {
                "type": "map",
                "values": {
                  "type": "record",
                  "name": "DescriptorType",
                  "namespace": "io.xregistry.descriptorgroups",
                  "fields": [
                    {
                      "name": "descriptorid",
                      "type": "string",
                      "description": "ID of the descriptor object"
                    },
                    {
                      "name": "name",
                      "type": [
                        "string",
                        "null"
                      ],
                      "doc": "Name of the object"
                    },
                    {
                      "name": "epoch",
                      "type": [
                        "int",
                        "null"
                      ],
                      "doc": "Epoch time of the object creation"
                    },
                    {
                      "name": "self",
                      "type": "string",
                      "doc": "URL of the object"
                    },
                    {
                      "name": "xid",
                      "type": "string",
                      "doc": "XID of the object"
                    },
                    {
                      "name": "description",
                      "type": [
                        "string",
                        "null"
                      ],
                      "doc": "Description of the object"
                    },
                    {
                      "name": "documentation",
                      "type": [
                        "string",
                        "null"
                      ],
                      "doc": "URI of the documentation of the object"
                    },
                    {
                      "name": "labels",
                      "type": {
                        "type": "map",
                        "values": [
                          "string",
                          "null"
                        ]
                      },
                      "doc": "Labels for the object"
                    },
                    {
                      "name": "createdat",
                      "type": [
                        {
                          "type": "int",
                          "logicalType": "time-millis"
                        },
                        "null"
                      ],
                      "doc": "Time of the object creation"
                    },
                    {
                      "name": "modifiedat",
                      "type": [
                        {
                          "type": "int",
                          "logicalType": "time-millis"
                        },
                        "null"
                      ],
                      "doc": "Time of the object modification"
                    },
                    {
                      "type": {
                        "type": "map",
                        "name": "ReferencesType",
                        "values": {
                          "type": "map",
                          "name": "ReferencesItemType",
                          "values": {
                            "type": "record",
                            "name": "ReferencesItemItemType",
                            "fields": [
                              {
                                "type": "string",
                                "doc": "Absolute fragment-free retrieval URL, used without modification",
                                "name": "url"
                              },
                              {
                                "name": "Extensions",
                                "type": [
                                  "null",
                                  {
                                    "type": "map",
                                    "name": "ExtensionsType",
                                    "default": {},
                                    "values": "io.xregistry.GenericRecord"
                                  }
                                ],
                                "default": null
                              }
                            ]
                          }
                        }
                      },
                      "name": "references",
                      "doc": "Reference type buckets containing named References; names are unique across all buckets and the map can be empty"
                    },
                    {
                      "type": [
                        "null",
                        {
                          "type": "map",
                          "name": "DataType",
                          "values": "io.xregistry.GenericRecord"
                        }
                      ],
                      "name": "data",
                      "doc": "Profile-defined inline values keyed by type; values follow Core and applicable profile definitions and are not retrieved as References",
                      "default": null
                    },
                    {
                      "type": [
                        "null",
                        "string"
                      ],
                      "doc": "Absolute fragment-free identity URI of the primary entity; not a retrieval instruction",
                      "name": "entityid",
                      "default": null
                    },
                    {
                      "type": [
                        "null",
                        "string"
                      ],
                      "doc": "Type URI with a scheme from an agreed vocabulary; a fragment can identify an ontology class; requires entityid",
                      "name": "entitytype",
                      "default": null
                    },
                    {
                      "name": "Extensions",
                      "type": [
                        "null",
                        {
                          "type": "map",
                          "name": "ExtensionsType",
                          "default": {},
                          "values": "io.xregistry.GenericRecord"
                        }
                      ],
                      "default": null
                    }
                  ]
                }
              }
            }
          ]
        }
      }
    }
  ]
}