{
  "$schema": "https://json-structure.org/meta/extended/v0/#",
  "$id": "https://xregistry.io/workingdrafts/models/descriptor/schemas/document-schema.struct.json",
  "$uses": [
    "JSONStructureAlternateNames"
  ],
  "name": "DescriptorRegistryDocument",
  "type": "object",
  "properties": {
    "descriptorgroups": {
      "type": "map",
      "values": {
        "type": {
          "$ref": "#/definitions/Descriptorgroups/Descriptorgroup"
        }
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "Descriptorgroups": {
      "DescriptorVersionReferencesValueValue": {
        "type": "object",
        "properties": {
          "url": {
            "type": "uri",
            "description": "Absolute fragment-free retrieval URL, used without modification"
          }
        },
        "additionalProperties": true,
        "required": [
          "url"
        ]
      },
      "DescriptorVersion": {
        "type": "object",
        "properties": {
          "versionid": {
            "type": "string",
            "description": "ID of the descriptor version"
          },
          "descriptorid": {
            "type": "string",
            "description": "ID of the descriptor object"
          },
          "name": {
            "type": "string",
            "description": "Name of the object"
          },
          "epoch": {
            "type": "integer",
            "description": "Epoch of the object"
          },
          "self": {
            "type": "uri",
            "description": "URL of the object"
          },
          "xid": {
            "type": "uri",
            "description": "XID of the object"
          },
          "description": {
            "type": "string",
            "description": "Description of the object"
          },
          "documentation": {
            "type": "uri",
            "description": "Documentation URL"
          },
          "labels": {
            "type": "map",
            "values": {
              "type": "string"
            }
          },
          "createdat": {
            "type": "datetime",
            "description": "Creation time"
          },
          "modifiedat": {
            "type": "datetime",
            "description": "Modification time"
          },
          "references": {
            "type": "map",
            "values": {
              "type": "map",
              "values": {
                "type": {
                  "$ref": "#/definitions/Descriptorgroups/DescriptorVersionReferencesValueValue"
                }
              }
            },
            "description": "Reference type buckets containing named References; names are unique across all buckets and the map can be empty"
          },
          "data": {
            "type": "map",
            "values": {
              "type": "any"
            },
            "description": "Profile-defined inline values keyed by type; values follow Core and applicable profile definitions and are not retrieved as References"
          },
          "entityid": {
            "type": "uri",
            "description": "Absolute fragment-free identity URI of the primary entity; not a retrieval instruction"
          },
          "entitytype": {
            "type": "uri",
            "description": "Type URI with a scheme from an agreed vocabulary; a fragment can identify an ontology class; requires entityid"
          }
        },
        "additionalProperties": true,
        "required": [
          "references"
        ]
      },
      "Descriptor": {
        "type": "object",
        "properties": {
          "descriptorid": {
            "type": "string",
            "description": "ID of the descriptor object"
          },
          "name": {
            "type": "string",
            "description": "Name of the object"
          },
          "epoch": {
            "type": "integer",
            "description": "Epoch of the object"
          },
          "self": {
            "type": "uri",
            "description": "URL of the object"
          },
          "xid": {
            "type": "uri",
            "description": "XID of the object"
          },
          "description": {
            "type": "string",
            "description": "Description of the object"
          },
          "documentation": {
            "type": "uri",
            "description": "Documentation URL"
          },
          "labels": {
            "type": "map",
            "values": {
              "type": "string"
            }
          },
          "createdat": {
            "type": "datetime",
            "description": "Creation time"
          },
          "modifiedat": {
            "type": "datetime",
            "description": "Modification time"
          },
          "versionsurl": {
            "type": "uri"
          },
          "versionscount": {
            "type": "uint32"
          },
          "versions": {
            "type": "map",
            "values": {
              "type": {
                "$ref": "#/definitions/Descriptorgroups/DescriptorVersion"
              }
            }
          }
        },
        "additionalProperties": false
      },
      "Descriptorgroup": {
        "type": "object",
        "properties": {
          "descriptorgroupid": {
            "type": "string",
            "description": "ID of the descriptorgroup object"
          },
          "name": {
            "type": "string",
            "description": "Name of the object"
          },
          "epoch": {
            "type": "integer",
            "description": "Epoch of the object"
          },
          "self": {
            "type": "uri",
            "description": "URL of the object"
          },
          "xid": {
            "type": "uri",
            "description": "XID of the object"
          },
          "description": {
            "type": "string",
            "description": "Description of the object"
          },
          "documentation": {
            "type": "uri",
            "description": "Documentation URL"
          },
          "labels": {
            "type": "map",
            "values": {
              "type": "string"
            }
          },
          "createdat": {
            "type": "datetime",
            "description": "Creation time"
          },
          "modifiedat": {
            "type": "datetime",
            "description": "Modification time"
          },
          "descriptors": {
            "type": "map",
            "values": {
              "type": {
                "$ref": "#/definitions/Descriptorgroups/Descriptor"
              }
            }
          }
        },
        "additionalProperties": true
      }
    }
  }
}