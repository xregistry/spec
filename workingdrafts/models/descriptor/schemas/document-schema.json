{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://xregistry.io/workingdrafts/models/descriptor/schemas/document-schema.json",
  "properties": {
    "descriptorgroups": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/descriptorgroup-schema/descriptorgroup"
      }
    }
  },
  "definitions": {
    "descriptorgroup-schema": {
      "descriptorVersion": {
        "type": "object",
        "properties": {
          "versionid": {
            "type": "string",
            "description": "ID of the descriptor version"
          },
          "descriptorid": {
            "type": "string",
            "description": "ID of the descriptor object"
          },
          "name": {
            "type": "string",
            "description": "Name of the object"
          },
          "epoch": {
            "type": "integer",
            "description": "Epoch time of the object creation"
          },
          "self": {
            "type": "string",
            "format": "uri-reference",
            "description": "URL of the object"
          },
          "xid": {
            "type": "string",
            "format": "xid",
            "description": "Relative URL of the object"
          },
          "description": {
            "type": "string",
            "description": "Description of the object"
          },
          "documentation": {
            "type": "string",
            "format": "uri-reference",
            "description": "URI of the documentation of the object"
          },
          "labels": {
            "type": "object",
            "description": "Labels for the object"
          },
          "createdat": {
            "type": "string",
            "format": "date-time",
            "description": "Time of the object creation"
          },
          "modifiedat": {
            "type": "string",
            "format": "date-time",
            "description": "Time of the object modification"
          },
          "references": {
            "type": "object",
            "description": "Reference type buckets containing named References; names are unique across all buckets and the map can be empty",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "url": {
                    "type": "string",
                    "format": "uri",
                    "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^#]*$",
                    "description": "Absolute fragment-free retrieval URL, used without modification"
                  }
                },
                "required": [
                  "url"
                ]
              }
            }
          },
          "data": {
            "type": "object",
            "description": "Profile-defined inline values keyed by type; values follow Core and applicable profile definitions and are not retrieved as References",
            "additionalProperties": {}
          },
          "entityid": {
            "type": "string",
            "format": "uri-reference",
            "description": "Absolute fragment-free identity URI of the primary entity; not a retrieval instruction"
          },
          "entitytype": {
            "type": "string",
            "format": "uri-reference",
            "description": "Type URI with a scheme from an agreed vocabulary; a fragment can identify an ontology class; requires entityid"
          }
        },
        "required": [
          "references"
        ]
      },
      "descriptor": {
        "type": "object",
        "properties": {
          "descriptorid": {
            "type": "string",
            "description": "ID of the descriptor object"
          },
          "name": {
            "type": "string",
            "description": "Name of the object"
          },
          "epoch": {
            "type": "integer",
            "description": "Epoch time of the object creation"
          },
          "self": {
            "type": "string",
            "format": "uri-reference",
            "description": "URL of the object"
          },
          "xid": {
            "type": "string",
            "format": "xid",
            "description": "Relative URL of the object"
          },
          "description": {
            "type": "string",
            "description": "Description of the object"
          },
          "documentation": {
            "type": "string",
            "format": "uri-reference",
            "description": "URI of the documentation of the object"
          },
          "labels": {
            "type": "object",
            "description": "Labels for the object"
          },
          "createdat": {
            "type": "string",
            "format": "date-time",
            "description": "Time of the object creation"
          },
          "modifiedat": {
            "type": "string",
            "format": "date-time",
            "description": "Time of the object modification"
          },
          "versionsurl": {
            "type": "string",
            "format": "uri"
          },
          "versionscount": {
            "type": "integer"
          },
          "versions": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/definitions/descriptorgroup-schema/descriptorVersion"
            }
          }
        }
      },
      "descriptorgroup": {
        "type": "object",
        "properties": {
          "descriptorgroupid": {
            "type": "string",
            "description": "ID of the descriptorgroup object"
          },
          "name": {
            "type": "string",
            "description": "Name of the object"
          },
          "epoch": {
            "type": "integer",
            "description": "Epoch time of the object creation"
          },
          "self": {
            "type": "string",
            "format": "uri-reference",
            "description": "URL of the object"
          },
          "xid": {
            "type": "string",
            "format": "xid",
            "description": "Relative URL of the object"
          },
          "description": {
            "type": "string",
            "description": "Description of the object"
          },
          "documentation": {
            "type": "string",
            "format": "uri-reference",
            "description": "URI of the documentation of the object"
          },
          "labels": {
            "type": "object",
            "description": "Labels for the object"
          },
          "createdat": {
            "type": "string",
            "format": "date-time",
            "description": "Time of the object creation"
          },
          "modifiedat": {
            "type": "string",
            "format": "date-time",
            "description": "Time of the object modification"
          },
          "descriptors": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/definitions/descriptorgroup-schema/descriptor"
            }
          }
        }
      }
    }
  }
}