{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xregistry.io/workingdrafts/federation/schemas/request.json",
  "title": "Federation abstract read example",
  "description": "Example envelope, not a new protocol. Typed target semantics require Core model validation.",
  "type": "object",
  "properties": {
    "operation": {
      "enum": ["entity", "collection", "document", "model", "capabilities"]
    },
    "target": {
      "type": "string",
      "pattern": "^/"
    },
    "selector": {
      "type": "object",
      "properties": {
        "label": {"type": "string"},
        "value": {"type": "string"}
      },
      "required": ["label", "value"],
      "additionalProperties": false
    }
  },
  "required": ["operation", "target"],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"required": ["selector"]},
      "then": {"properties": {"operation": {"const": "collection"}}}
    },
    {
      "if": {"properties": {"operation": {"enum": ["model", "capabilities"]}}},
      "then": {"properties": {"target": {"const": "/"}}}
    }
  ]
}
