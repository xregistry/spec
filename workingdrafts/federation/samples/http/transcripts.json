{
  "format": "xregistry-http-examples-v1",
  "supportedSpecversions": ["1.0-rc4"],
  "selectors": [
    {
      "name": "case-insensitive-value",
      "selector": {"label": "stage", "value": "PRODUCTION"},
      "entities": [
        {"assetid": "item", "labels": {"stage": "production"}},
        {"assetid": "other", "labels": {"stage": "development"}}
      ],
      "expected": "item",
      "filter": "labels.stage=PRODUCTION"
    },
    {
      "name": "empty-is-not-absent",
      "selector": {"label": "note", "value": ""},
      "entities": [
        {"assetid": "item", "labels": {"note": ""}},
        {"assetid": "unlabeled"}
      ],
      "expected": "item",
      "filter": "labels.note="
    },
    {
      "name": "literal-star",
      "selector": {"label": "note", "value": "A*B"},
      "entities": [
        {"assetid": "item", "labels": {"note": "a*b"}},
        {"assetid": "other", "labels": {"note": "axxb"}}
      ],
      "expected": "item",
      "filter": "labels.note=A\\*B"
    },
    {
      "name": "dot-in-label-key",
      "selector": {"label": "release.channel", "value": "stable"},
      "entities": [
        {"assetid": "item", "labels": {"release.channel": "STABLE"}},
        {"assetid": "other", "labels": {"channel": "stable"}}
      ],
      "expected": "item",
      "filter": "labels['release.channel']=stable"
    },
    {
      "name": "literal-null-fallback",
      "selector": {"label": "note", "value": "null"},
      "entities": [
        {"assetid": "item", "labels": {"note": "NULL"}},
        {"assetid": "unlabeled"}
      ],
      "expected": "item",
      "filter": null
    },
    {
      "name": "comma-fallback",
      "selector": {"label": "note", "value": "a,b"},
      "entities": [
        {"assetid": "item", "labels": {"note": "A,B"}}
      ],
      "expected": "item",
      "filter": null
    },
    {
      "name": "no-unicode-normalization",
      "selector": {"label": "note", "value": "\u00e9"},
      "entities": [
        {"assetid": "item", "labels": {"note": "\u00c9"}},
        {"assetid": "other", "labels": {"note": "e\u0301"}}
      ],
      "expected": "item",
      "filter": null
    },
    {
      "name": "no-match",
      "selector": {"label": "note", "value": ""},
      "entities": [{"assetid": "unlabeled"}],
      "error": "not_found",
      "filter": "labels.note="
    }
  ],
  "transcripts": [
    {
