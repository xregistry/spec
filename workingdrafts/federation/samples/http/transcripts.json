    {
      "name": "range-restart",
      "note": "Range-processing excerpt; only representation headers are retained.",
      "endpoint": "https://first.example.com/services/xreg/",
      "exchanges": [
        {
          "request": {
            "url": "https://first.example.com/services/xreg/documents/main/assets/item/versions/v2",
            "headers": {"Range": "bytes=0-1"}
          },
          "response": {
            "status": 206,
            "headers": {
              "Content-Type": "application/octet-stream",
              "Content-Length": "2",
              "Content-Range": "bytes 0-1/4",
              "ETag": "\"old-bytes\""
            },
            "text": "AB"
          }
        },
        {
          "request": {
            "url": "https://first.example.com/services/xreg/documents/main/assets/item/versions/v2",
            "headers": {"Range": "bytes=2-3", "If-Range": "\"old-bytes\""}
          },
          "response": {
            "status": 200,
            "headers": {
              "Content-Type": "application/octet-stream",
              "Content-Length": "4",
              "ETag": "\"new-bytes\""
            },
            "text": "WXYZ"
          }
        }
      ],
      "expected": {"text": "WXYZ", "discardedPartial": "AB"}
    },
    {
      "name": "authorization-stops-resolution",
      "endpoint": "https://first.example.com/services/xreg/",
      "exchanges": [
        {
          "request": {"url": "https://first.example.com/services/xreg/documents/main/assets", "headers": {}},
