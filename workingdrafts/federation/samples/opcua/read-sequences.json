    {
      "name": "three-browse-pages-with-reused-continuation-token",
      "kind": "sequence",
      "input": {
        "sequence": {
          "kind": "browse",
          "request": {"operation": "collection", "target": "/documents/main/assets/item/versions"},
          "namespaceArray": ["http://opcfoundation.org/UA/", "urn:example:registry"],
          "events": [
            {
              "service": "Browse", "session": "session-1", "nodeId": "ns=1;s=MainGroup",
              "input": {"requestedMaxReferencesPerNode": 1}, "status": "Good",
              "output": {
                "references": [
                  {
                    "nodeId": {
                      "serverIndex": 0, "namespaceIndex": 1,
                      "identifierType": "String", "identifier": "ItemV1"
                    },
                    "browseName": {"namespaceIndex": 1, "name": "v1"}
                  }
                ],
                "continuationPoint": "cDE="
              }
            },
            {
              "service": "BrowseNext", "session": "session-1", "nodeId": "ns=1;s=MainGroup",
              "input": {"continuationPoints": ["cDE="], "releaseContinuationPoints": false},
              "status": "Good",
              "output": {
                "references": [
                  {
                    "nodeId": {
                      "serverIndex": 0, "namespaceIndex": 1,
                      "identifierType": "String", "identifier": "ItemV2"
                    },
                    "browseName": {"namespaceIndex": 1, "name": "v2"}
                  }
                ],
                "continuationPoint": "cDE="
              }
            },
            {
              "service": "BrowseNext", "session": "session-1", "nodeId": "ns=1;s=MainGroup",
              "input": {"continuationPoints": ["cDE="], "releaseContinuationPoints": false},
              "status": "Good",
              "output": {
                "references": [
                  {
                    "nodeId": {
                      "serverIndex": 0, "namespaceIndex": 1,
                      "identifierType": "String", "identifier": "ItemV3"
                    },
                    "browseName": {"namespaceIndex": 1, "name": "v3"}
                  }
                ],
                "continuationPoint": null
              }
            }
          ]
        }
      },
      "expected": {
        "references": [
          {
            "nodeId": {
              "serverIndex": 0, "namespaceIndex": 1,
              "identifierType": "String", "identifier": "ItemV1"
            },
            "browseName": {"namespaceIndex": 1, "name": "v1"}
          },
          {
            "nodeId": {
              "serverIndex": 0, "namespaceIndex": 1,
              "identifierType": "String", "identifier": "ItemV2"
            },
            "browseName": {"namespaceIndex": 1, "name": "v2"}
          },
          {
            "nodeId": {
              "serverIndex": 0, "namespaceIndex": 1,
              "identifierType": "String", "identifier": "ItemV3"
            },
            "browseName": {"namespaceIndex": 1, "name": "v3"}
          }
        ],
        "complete": true,
        "trace": ["Browse", "BrowseNext", "BrowseNext"],
        "consistency": "unverified"
      }
    },
