{
  "format": "xregistry-opcua-examples-v1",
  "cases": [
    {
      "name": "registry-metadata",
      "kind": "sequence",
      "input": {
        "sequence": {
          "kind": "metadata",
          "specversion": "1.0-rc4",
          "request": {"operation": "entity", "target": "/"},
          "events": [
            {
              "service": "Read", "session": "session-1",
              "nodeId": "nsu=urn:example:registry;s=FirstRegistry",
              "status": "Good",
              "values": {
                "RegistryId": {"status": "Good", "value": "first"},
                "SpecVersion": {"status": "Good", "value": "1.0-rc4"},
                "Xid": {"status": "Good", "value": "/"}
              }
            }
          ]
        }
      },
      "expected": {
        "values": {"RegistryId": "first", "SpecVersion": "1.0-rc4", "Xid": "/"},
        "trace": ["Read"],
        "consistency": "unverified"
      }
    },
    {
      "name": "metadata-only-catalog",
      "kind": "sequence",
      "note": "xregurl and federationprofiles are typed, implementation-mapped Version extensions, not base companion Properties or Labels strings.",
      "input": {
        "sequence": {
          "kind": "metadata",
          "hasdocument": false,
          "specversion": "1.0-rc4",
          "request": {"operation": "entity", "target": "/categories/dev/registries/bridge"},
          "events": [
            {
              "service": "Read", "session": "session-1",
              "nodeId": "nsu=urn:example:registry;s=CatalogBridge",
              "status": "Good",
              "values": {
                "ResourceId": {"status": "Good", "value": "bridge"},
                "VersionId": {"status": "Good", "value": "v1"},
                "Xid": {"status": "Good", "value": "/categories/dev/registries/bridge"},
                "xregurl": {"status": "Good", "value": "https://first.example.com/services/xreg/"},
                "federationprofiles": {
                  "status": "Good",
                  "value": [
                    {
                      "name": "opcua",
                      "endpoint": "opc.tcp://ua.example.com:4840",
                      "parameters": {
                        "registryroot": "nsu=urn:example:registry;s=FirstRegistry",
                        "applicationuri": "urn:example:ua:first"
                      }
                    }
                  ]
                }
              }
            }
          ]
        }
      },
      "expected": {
        "values": {
          "ResourceId": "bridge",
          "VersionId": "v1",
          "Xid": "/categories/dev/registries/bridge",
          "xregurl": "https://first.example.com/services/xreg/",
          "federationprofiles": [
            {
              "name": "opcua",
              "endpoint": "opc.tcp://ua.example.com:4840",
              "parameters": {
                "registryroot": "nsu=urn:example:registry;s=FirstRegistry",
                "applicationuri": "urn:example:ua:first"
              }
            }
          ]
        },
        "trace": ["Read"],
        "consistency": "unverified"
      }
    },
    {
      "name": "default-v1-short-chunks",
      "kind": "sequence",
      "input": {
        "sequence": {
          "kind": "file",
          "specversion": "1.0-rc4",
          "request": {"operation": "document", "target": "/documents/main/assets/item"},
          "selectedXid": "/documents/main/assets/item/versions/v1",
          "namespaceArray": [
            "http://opcfoundation.org/UA/", "urn:example:other",
            "urn:example:companion", "urn:example:registry"
          ],
          "expectedSize": 17,
          "before": {"defaultversionid": "v1", "versionid": "v1", "epoch": 1, "size": 17},
          "after": {"defaultversionid": "v1", "versionid": "v1", "epoch": 1, "size": 17},
          "events": [
            {
              "service": "Call", "session": "session-1", "nodeId": "ns=3;s=ItemV1",
              "method": "Open", "input": {"mode": 1},
              "status": "Good", "output": {"fileHandle": 41}
            },
            {
              "service": "Call", "session": "session-1", "nodeId": "ns=3;s=ItemV1",
              "method": "Read", "input": {"fileHandle": 41, "length": 64},
              "status": "Good", "output": {"data": "eyJ0eXBlIjo="}
            },
            {
              "service": "Call", "session": "session-1", "nodeId": "ns=3;s=ItemV1",
              "method": "Read", "input": {"fileHandle": 41, "length": 64},
              "status": "Good", "output": {"data": "InN0cmluZyJ9"}
            },
            {
              "service": "Call", "session": "session-1", "nodeId": "ns=3;s=ItemV1",
              "method": "Read", "input": {"fileHandle": 41, "length": 64},
              "status": "Good", "output": {"data": ""}
            },
            {
              "service": "Call", "session": "session-1", "nodeId": "ns=3;s=ItemV1",
              "method": "Close", "input": {"fileHandle": 41}, "status": "Good"
            }
          ]
        }
      },
      "expected": {
        "data": "eyJ0eXBlIjoic3RyaW5nIn0=",
        "size": 17,
        "complete": true,
        "trace": ["Open", "Read", "Read", "Read", "Close"],
        "consistency": "observed",
        "selectedXid": "/documents/main/assets/item/versions/v1"
      }
    },
