    {
      "name": "remote-source-tables-to-target-seven",
      "kind": "reference",
      "input": {
        "reference": {
          "serverIndex": 2,
          "namespaceIndex": 3,
          "identifierType": "String",
          "identifier": "ItemV1"
        },
        "source_server_array": [
          "urn:example:ua:first", "urn:example:ua:unrelated", "urn:example:ua:remote"
        ],
        "source_namespace_array": [
          "http://opcfoundation.org/UA/", "urn:example:source",
          "urn:example:unused", "urn:example:registry"
        ],
        "target_applicationuri": "urn:example:ua:remote",
        "target_namespace_array": [
          "http://opcfoundation.org/UA/",
          "urn:example:other1", "urn:example:other2", "urn:example:other3",
          "urn:example:other4", "urn:example:other5", "urn:example:other6",
          "urn:example:registry"
        ]
      },
      "expected": {
        "applicationuri": "urn:example:ua:remote",
        "namespaceUri": "urn:example:registry",
        "nodeId": "ns=7;s=ItemV1",
        "portable": "svu=urn:example:ua:remote;nsu=urn:example:registry;s=ItemV1",
        "local": false
      }
    },
