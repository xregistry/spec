          },
          "self": {
            "type": "uri",
            "description": "URL of the object"
          },
          "xid": {
            "type": "uri",
            "description": "XID of the object"
          },
          "description": {
            "type": "string",
            "description": "Description of the object"
          },
          "documentation": {
            "type": "uri",
            "description": "Documentation URL"
          },
          "labels": {
            "type": "map",
            "values": {
              "type": "string"
            }
          },
          "createdat": {
            "type": "datetime",
            "description": "Creation time"
          },
          "modifiedat": {
            "type": "datetime",
            "description": "Modification time"
          },
          "channels": {
            "type": "map",
            "values": {
              "type": {
                "$ref": "#/definitions/Publications/Channel"
              }
            }
          },
          "snapshots": {
            "type": "map",
            "values": {
              "type": {
                "$ref": "#/definitions/Publications/Snapshot"
              }
            }
          }
        },
        "additionalProperties": false
      }
    }
  }
}