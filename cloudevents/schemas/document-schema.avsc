{
  "type": "record",
  "name": "DocumentType",
  "namespace": "io.xregistry",
  "fields": [
    {
      "name": "genericRecordDefinition",
      "type": {
        "type": "array",
        "items": {
          "type": "record",
          "name": "GenericRecord",
          "fields": [
            {
              "name": "object",
              "type": {
                "type": "map",
                "values": [
                  "null",
                  "boolean",
                  "int",
                  "long",
                  "float",
                  "double",
                  "bytes",
                  "string",
                  {
                    "type": "array",
                    "items": [
                      "null",
                      "boolean",
                      "int",
                      "long",
                      "float",
                      "double",
                      "bytes",
                      "string",
                      "io.xregistry.GenericRecord"
                    ]
                  },
                  "io.xregistry.GenericRecord"
                ]
              }
            }
          ]
        }
      },
      "default": [],
      "doc": "Internal field to define GenericRecord type for use in extension attributes"
    },
