                                    }
                                  }
                                ]
                              }
                            },
                            "name": "endpoints",
                            "doc": "The network addresses that are for communication with the endpoint. The endpoints are ordered by preference, with the first endpoint being the preferred endpoint. Some protocol implementations might not support multiple endpoints, in which case all but the first endpoint might be ignored. Whether the URI just identifies a network host or links directly to a resource managed by the network host is protocol specific"
                          },
                          {
                            "type": {
                              "type": "array",
                              "name": "ProtocolNATSProtocoloptionsAuthorizationArrayType",
                              "items": {
                                "type": "record",
                                "name": "ProtocolNATSProtocoloptionsAuthorizationType",
                                "fields": [
                                  {
                                    "type": "string",
                                    "doc": "The authentication/authorization type. OAuth2, Plain, APIKey, X509Cert, and SASL are well-defined",
                                    "name": "type"
                                  },
                                  {
                                    "type": "string",
                                    "doc": "The SASL mechanism name when authorization.type is SASL (for example PLAIN, SCRAM-SHA-256, SCRAM-SHA-512, OAUTHBEARER, or EXTERNAL)",
                                    "name": "mechanism"
                                  },
                                  {
                                    "type": "string",
                                    "doc": "The resource uri for which authorization shall be granted (if applicable)",
                                    "name": "resourceuri"
                                  },
                                  {
                                    "type": "string",
                                    "doc": "The authority uri where authorization shall be requested (if applicable)",
                                    "name": "authorityuri"
                                  },
                                  {
                                    "name": "Extensions",
                                    "type": {
                                      "type": "map",
                                      "name": "ProtocolNATSProtocoloptionsAuthorizationExtensionsType",
                                      "default": {},
                                      "values": "io.xregistry.GenericRecord"
                                    }
                                  }
                                ]
                              }
                            },
                            "name": "authorization",
                            "doc": "Authorization options. These are hints for the adapter for interacting with the authorization endpoint. This is not a credentials configuration"
                          },
                          {
                            "type": "boolean",
                            "doc": "If `true`, the endpoint metadata represents a public endpoint that is expected to be available for communication",
                            "name": "deployed"
                          },
                          {
                            "type": "string",
                            "doc": "The concrete NATS publish subject. It MUST NOT contain the '*' or '>' wildcard tokens",
                            "name": "subject"
                          },
                          {
                            "type": "string",
                            "doc": "The NATS subscription subject filter. It MAY contain the '*' and '>' wildcard tokens",
                            "name": "subjectfilter"
                          },
                          {
                            "type": "string",
                            "doc": "The NATS queue group for queue subscriptions. It MUST only be used together with 'subjectfilter'",
                            "name": "queuegroup"
                          },
                          {
                            "name": "Extensions",
                            "type": {
                              "type": "map",
                              "name": "ProtocolNATSProtocoloptionsExtensionsType",
                              "default": {},
                              "values": "io.xregistry.GenericRecord"
                            }
                          }
                        ]
                      },
                      "name": "protocoloptions",
                      "doc": "Configuration information for this endpoint"
                    }
                  ]
                }
              ],
              "doc": "Endpoint protocol identifier. If set, all definitions MUST use this protocol value"
