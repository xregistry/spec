                "type": "map",
                "values": [
                  "string",
                  "null"
                ]
              },
              "doc": "Labels for the object"
            },
            {
              "name": "createdat",
              "type": [
                {
                  "type": "int",
                  "logicalType": "time-millis"
                },
                "null"
              ],
              "doc": "Time of the object creation"
            },
            {
              "name": "modifiedat",
              "type": [
                {
                  "type": "int",
                  "logicalType": "time-millis"
                },
                "null"
              ],
              "doc": "Time of the object modification"
            },
            {
              "type": {
                "type": "array",
                "name": "UsageArrayType",
                "items": {
                  "type": "string"
                }
              },
              "name": "usage",
              "doc": "Client's expected usage of this endpoint. A single role is required, except `subscriber` and `consumer` may be combined for AMQP/1.0, MQTT/3.1.1, MQTT/5.0, or NATS."
            },
            {
              "type": "string",
              "doc": "The name of the channel",
              "name": "channel"
            },
            {
              "type": {
                "type": "record",
                "name": "DeprecatedType",
                "fields": [
                  {
                    "type": {
                      "type": "int",
                      "logicalType": "timestamp-millis"
                    },
                    "name": "effective",
                    "doc": "tbd"
                  },
                  {
                    "type": {
                      "type": "int",
                      "logicalType": "timestamp-millis"
                    },
                    "name": "removal",
                    "doc": "tbd"
                  },
                  {
                    "type": "string",
                    "doc": "tbd",
                    "name": "alternative"
                  },
                  {
                    "type": "string",
                    "doc": "tbd",
                    "name": "docs"
                  },
                  {
                    "name": "Extensions",
                    "type": {
                      "type": "map",
                      "name": "DeprecatedExtensionsType",
                      "default": {},
                      "values": "io.xregistry.GenericRecord"
                    }
                  }
                ]
              },
              "name": "deprecated",
              "doc": "Indicates whether the endpoint is deprecated"
            },
            {
              "name": "envelope",
              "type": [
                {
                  "type": "record",
                  "namespace": "io.xregistry.endpoints",
                  "name": "EnvelopeCloudevents10Type",
                  "fields": [
                    {
                      "type": {
                        "type": "record",
                        "name": "EnvelopeCloudevents10EnvelopeoptionsType",
                        "fields": [
                          {
                            "type": "string",
                            "name": "mode"
                          },
                          {
                            "type": "string",
                            "name": "format"
                          },
                          {
                            "name": "Extensions",
                            "type": {
                              "type": "map",
                              "name": "EnvelopeCloudevents10EnvelopeoptionsExtensionsType",
                              "default": {},
                              "values": "io.xregistry.GenericRecord"
                            }
                          }
                        ]
                      },
                      "name": "envelopeoptions",
                      "doc": "Envelope metadata constraints"
                    }
                  ]
                }
              ],
              "doc": "Envelope metadata format identifier. If set, all definitions MUST use this format value"
            },
            {
              "name": "protocol",
              "type": [
                {
                  "type": "record",
                  "namespace": "io.xregistry.endpoints",
                  "name": "ProtocolAmqp10Type",
                  "fields": [
                    {
                      "type": {
                        "type": "record",
                        "name": "ProtocolAmqp10ProtocoloptionsType",
                        "fields": [
                          {
                            "type": {
                              "type": "array",
                              "name": "ProtocolAmqp10ProtocoloptionsEndpointsArrayType",
                              "items": {
                                "type": "record",
                                "name": "ProtocolAmqp10ProtocoloptionsEndpointsType",
                                "fields": [
                                  {
                                    "type": "string",
                                    "doc": "AMQP Addressing URI",
                                    "name": "uri"
                                  },
                                  {
                                    "name": "Extensions",
                                    "type": {
                                      "type": "map",
                                      "name": "ProtocolAmqp10ProtocoloptionsEndpointsExtensionsType",
                                      "default": {},
                                      "values": "io.xregistry.GenericRecord"
                                    }
                                  }
                                ]
                              }
                            },
                            "name": "endpoints",
                            "doc": "The network addresses that are for communication with the endpoint. The endpoints are ordered by preference, with the first endpoint being the preferred endpoint. Some protocol implementations might not support multiple endpoints, in which case all but the first endpoint might be ignored. Whether the URI just identifies a network host or links directly to a resource managed by the network host is protocol specific"
                          },
                          {
                            "type": {
                              "type": "array",
                              "name": "ProtocolAmqp10ProtocoloptionsAuthorizationArrayType",
                              "items": {
                                "type": "record",
                                "name": "ProtocolAmqp10ProtocoloptionsAuthorizationType",
                                "fields": [
                                  {
                                    "type": "string",
                                    "doc": "The authentication/authorization type. OAuth2, Plain, APIKey, X509Cert, and SASL are well-defined",
                                    "name": "type"
                                  },
                                  {
                                    "type": "string",
                                    "doc": "The SASL mechanism name when authorization.type is SASL (for example PLAIN, SCRAM-SHA-256, SCRAM-SHA-512, OAUTHBEARER, or EXTERNAL)",
                                    "name": "mechanism"
                                  },
                                  {
                                    "type": "string",
                                    "doc": "The resource uri for which authorization shall be granted (if applicable)",
                                    "name": "resourceuri"
                                  },
                                  {
                                    "type": "string",
                                    "doc": "The authority uri where authorization shall be requested (if applicable)",
                                    "name": "authorityuri"
                                  },
                                  {
                                    "name": "Extensions",
                                    "type": {
                                      "type": "map",
                                      "name": "ProtocolAmqp10ProtocoloptionsAuthorizationExtensionsType",
                                      "default": {},
                                      "values": "io.xregistry.GenericRecord"
                                    }
                                  }
                                ]
                              }
                            },
                            "name": "authorization",
                            "doc": "Authorization options. These are hints for the adapter for interacting with the authorization endpoint. This is not a credentials configuration"
                          },
                          {
                            "type": "boolean",
                            "doc": "If `true`, the endpoint metadata represents a public endpoint that is expected to be available for communication",
                            "name": "deployed"
                          },
                          {
                            "type": "string",
                            "doc": "The AMQP node name. Commonly the name of a queue or a topic. Corresponds to the 'address' in source or target of the attach frame.",
                            "name": "node"
                          },
                          {
                            "type": "boolean",
                            "doc": "Whether the AMQP node identified by 'node' is durable rather than transient. This is a property of the node, not of the link terminus and not of the message header field of the same name. Terminus durability is expressed by 'terminus-durability'",
                            "name": "durable"
                          },
                          {
                            "type": {
                              "type": "map",
                              "name": "ProtocolAmqp10ProtocoloptionsLinkPropertiesType",
                              "values": "string"
                            },
                            "name": "linkProperties",
                            "doc": "An optional map of AMQP link properties to use with the endpoint"
                          },
                          {
                            "type": {
                              "type": "map",
                              "name": "ProtocolAmqp10ProtocoloptionsConnectionPropertiesType",
                              "values": "string"
                            },
                            "name": "connectionProperties",
                            "doc": "An optional map of AMQP connection properties to use with the endpoint"
                          },
                          {
                            "type": "string",
                            "doc": "The AMQP source distribution mode. 'move' means a transferred message is removed from the node and is therefore seen by only one receiver. 'copy' means the message remains at the node after transfer and may also be transferred to other receivers. This does not describe message locking",
                            "name": "distributionMode"
                          },
                          {
                            "type": {
                              "type": "array",
                              "name": "ProtocolAmqp10ProtocoloptionsConnectionCapabilitiesArrayType",
                              "items": {
                                "type": "string"
                              }
                            },
                            "name": "connectionCapabilities",
                            "doc": "The AMQP capabilities to use with the endpoint"
                          },
                          {
                            "type": {
                              "type": "array",
                              "name": "ProtocolAmqp10ProtocoloptionsNodeCapabilitiesArrayType",
                              "items": {
                                "type": "string"
                              }
                            },
                            "name": "nodeCapabilities",
                            "doc": "The AMQP node capabilities to use with the endpoint"
                          },
                          {
                            "type": {
                              "type": "map",
                              "name": "ProtocolAmqp10ProtocoloptionsSourceFiltersType",
                              "values": "io.xregistry.GenericRecord"
                            },
                            "name": "sourceFilters",
                            "doc": "AMQP source filters used for subscription/receive setup"
                          },
                          {
                            "type": "boolean",
                            "doc": "Whether a dynamic source or target is requested",
                            "name": "dynamic"
                          },
                          {
                            "type": "string",
                            "doc": "Durability mode for the applicable source/target terminus",
                            "name": "terminusDurability"
                          },
                          {
                            "type": "string",
                            "doc": "Expiry policy for the applicable source/target terminus",
                            "name": "expiryPolicy"
                          },
                          {
                            "type": "int",
                            "doc": "Timeout in seconds for the applicable expiry policy",
                            "name": "timeout"
                          },
                          {
                            "type": "string",
                            "doc": "AMQP sender settle mode requested for the link. It constrains the party that sends transfers over the link: the client for a producer endpoint, the remote node for a consumer endpoint",
                            "name": "senderSettleMode"
                          },
                          {
                            "type": "string",
                            "doc": "AMQP receiver settle mode requested for the link. It constrains the party that receives transfers over the link: the remote node for a producer endpoint, the client for a consumer endpoint",
                            "name": "receiverSettleMode"
                          },
                          {
                            "name": "Extensions",
                            "type": {
                              "type": "map",
                              "name": "ProtocolAmqp10ProtocoloptionsExtensionsType",
                              "default": {},
                              "values": "io.xregistry.GenericRecord"
                            }
                          }
                        ]
                      },
                      "name": "protocoloptions",
                      "doc": "Configuration information for this endpoint"
                    }
                  ]
                },
                {
                  "type": "record",
                  "namespace": "io.xregistry.endpoints",
                  "name": "ProtocolMqtt50Type",
                  "fields": [
                    {
                      "type": {
                        "type": "record",
                        "name": "ProtocolMqtt50ProtocoloptionsType",
                        "fields": [
                          {
                            "type": {
                              "type": "array",
                              "name": "ProtocolMqtt50ProtocoloptionsEndpointsArrayType",
                              "items": {
                                "type": "record",
                                "name": "ProtocolMqtt50ProtocoloptionsEndpointsType",
                                "fields": [
                                  {
                                    "type": "string",
                                    "doc": "MQTT URI (mqtt, mqtts, or ws scheme)",
                                    "name": "uri"
                                  },
                                  {
                                    "name": "Extensions",
                                    "type": {
                                      "type": "map",
                                      "name": "ProtocolMqtt50ProtocoloptionsEndpointsExtensionsType",
                                      "default": {},
                                      "values": "io.xregistry.GenericRecord"
                                    }
                                  }
                                ]
                              }
                            },
                            "name": "endpoints",
                            "doc": "The network addresses that are for communication with the endpoint. The endpoints are ordered by preference, with the first endpoint being the preferred endpoint. Some protocol implementations might not support multiple endpoints, in which case all but the first endpoint might be ignored. Whether the URI just identifies a network host or links directly to a resource managed by the network host is protocol specific"
                          },
                          {
                            "type": {
                              "type": "array",
                              "name": "ProtocolMqtt50ProtocoloptionsAuthorizationArrayType",
                              "items": {
                                "type": "record",
                                "name": "ProtocolMqtt50ProtocoloptionsAuthorizationType",
                                "fields": [
                                  {
                                    "type": "string",
                                    "doc": "The authentication/authorization type. OAuth2, Plain, APIKey, X509Cert, and SASL are well-defined",
                                    "name": "type"
                                  },
                                  {
                                    "type": "string",
                                    "doc": "The SASL mechanism name when authorization.type is SASL (for example PLAIN, SCRAM-SHA-256, SCRAM-SHA-512, OAUTHBEARER, or EXTERNAL)",
                                    "name": "mechanism"
                                  },
                                  {
                                    "type": "string",
                                    "doc": "The resource uri for which authorization shall be granted (if applicable)",
                                    "name": "resourceuri"
                                  },
                                  {
                                    "type": "string",
                                    "doc": "The authority uri where authorization shall be requested (if applicable)",
                                    "name": "authorityuri"
                                  },
                                  {
                                    "name": "Extensions",
                                    "type": {
                                      "type": "map",
                                      "name": "ProtocolMqtt50ProtocoloptionsAuthorizationExtensionsType",
                                      "default": {},
                                      "values": "io.xregistry.GenericRecord"
                                    }
                                  }
                                ]
                              }
                            },
                            "name": "authorization",
                            "doc": "Authorization options. These are hints for the adapter for interacting with the authorization endpoint. This is not a credentials configuration"
                          },
                          {
                            "type": "boolean",
                            "doc": "If `true`, the endpoint metadata represents a public endpoint that is expected to be available for communication",
                            "name": "deployed"
                          },
                          {
                            "type": "string",
                            "doc": "The concrete MQTT topic name that is used for communication with the endpoint unless overridden by the message. It MUST NOT contain the '+' or '#' wildcard characters",
                            "name": "topic"
                          },
                          {
                            "type": "int",
                            "doc": "The MQTT QoS level. May be 0, 1, or 2",
                            "name": "qos"
                          },
                          {
                            "type": "boolean",
                            "doc": "The MQTT retain flag to use for publishers on ths endpoint",
                            "name": "retain"
                          },
                          {
                            "type": "string",
                            "doc": "MQTT subscribe topic filter. MAY contain the '+' and '#' wildcard characters",
                            "name": "topicfilter"
                          },
                          {
                            "type": "boolean",
                            "doc": "MQTT 5 clean start flag",
                            "name": "cleanstart"
                          },
                          {
                            "type": "int",
                            "doc": "MQTT 5 session expiry interval in seconds",
                            "name": "sessionexpiryinterval"
                          },
                          {
                            "type": "string",
                            "doc": "MQTT 5 shared subscription group. It MUST only be used together with 'topicfilter' and MUST NOT include the '$share/' prefix",
                            "name": "sharedsubscriptiongroup"
                          },
                          {
                            "type": "boolean",
                            "doc": "MQTT 5 no-local subscription flag",
                            "name": "nolocal"
                          },
                          {
                            "type": "boolean",
                            "doc": "MQTT 5 retain-as-published subscription flag",
                            "name": "retainaspublished"
                          },
                          {
                            "type": "int",
                            "doc": "MQTT 5 retain-handling subscription mode",
                            "name": "retainhandling"
                          },
                          {
                            "type": "string",
                            "doc": "The MQTT will topic to configure for publishers on this endpoint",
                            "name": "willtopic"
                          },
                          {
                            "type": "string",
                            "doc": "The MQTT will message definition to configure for publishers on this endpoint. This MUST be a reference to a message definition",
                            "name": "willmessage"
                          },
                          {
                            "name": "Extensions",
                            "type": {
                              "type": "map",
                              "name": "ProtocolMqtt50ProtocoloptionsExtensionsType",
                              "default": {},
                              "values": "io.xregistry.GenericRecord"
                            }
                          }
                        ]
                      },
                      "name": "protocoloptions",
                      "doc": "Configuration information for this endpoint"
                    }
                  ]
                },
